# ─── KUSUSHI ENVIRONMENT ───
# Copy to .env.local and fill in. All fields have mock fallbacks.

# OpenAI — powers the agent + prescription OCR
OPENAI_API_KEY=

# Prava — sandbox payment
# Get from dashboard.prava.space (sk_test_... for sandbox)
PRAVA_SECRET_KEY=
PRAVA_PUBLIC_KEY=
# Sandbox base is auto-detected from sk_test prefix; override here if needed:
# PRAVA_BASE_URL=https://sandbox.api.prava.space

# Google Maps — optional, for real pharmacy discovery
GOOGLE_MAPS_API_KEY=

# Cron secret — authorizes the /api/linq/cron endpoint (closes iMessage Prava
# checkouts). Generate one: `openssl rand -hex 32`. Set the SAME value in BOTH:
#   1. Vercel project env: CRON_SECRET
#   2. GitHub Actions secret: gh secret set CRON_SECRET --repo <your-repo>
# The GH Actions workflow (.github/workflows/imessage-cron.yml) pings the
# endpoint every 2 min with this as a Bearer header. (We use GH Actions instead
# of native Vercel cron because Hobby caps Vercel cron at once-per-day.)
CRON_SECRET=

# ─── When keys are ABSENT, the app runs in MOCK mode ───
# Mock agent uses a deterministic parser for demo phrases.
# Mock Prava simulates the full payment lifecycle.
# Mock discovery uses a static pharmacy dataset.
